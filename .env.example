# Model. Without ANTHROPIC_API_KEY the app runs a labeled fake keyword model.
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-sonnet-5-5
TRIAGE_CONFIDENCE_THRESHOLD=0.8
# TRIAGE_MODE=fake            # force the fake model even with a key (CI)

# ServiceNow. Without these the app uses an in-memory mock incident store.
SERVICENOW_INSTANCE_URL=      # https://dev12345.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=

# Public-demo protection
DEMO_ACCESS_CODE=             # if set, the UI asks for it once per session
TRIAGE_RATE_LIMIT_PER_MIN=20

# Optional: USD per million tokens, shown as a per-request estimate when set
TRIAGE_PRICE_IN=
TRIAGE_PRICE_OUT=
TRIAGE_PRICE_CACHE_READ=
